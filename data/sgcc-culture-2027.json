          ]
        },
        {
          "id": "social",
          "title": "社会公德",
          "fact": "文明礼貌、助人为乐、爱护公物、保护环境、遵纪守法。",
          "meaning": "在社会上做一个好公民。",
          "trap": "题干已给文明礼貌时，其余四项仍要完整选择。",
